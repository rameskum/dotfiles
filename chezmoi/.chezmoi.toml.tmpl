{{- /*
  Written once by `chezmoi init`. No prompts, so `chezmoi init --apply` works
  unattended (containers, CI). The switch comes from the environment:

    DOTFILES_SKIP_INSTALL=1   do not run the package install script

  WSL is detected from the kernel string.
*/ -}}
{{- $wsl := false -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   $wsl = (get .chezmoi.kernel "osrelease" | lower | contains "microsoft") -}}
{{- end -}}
[data]
    installPackages = {{ eq (env "DOTFILES_SKIP_INSTALL") "" }}
    wsl = {{ $wsl }}
