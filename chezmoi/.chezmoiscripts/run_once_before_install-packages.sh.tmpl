{{- /*
  macOS, Linux and WSL: install the terminal tooling with Homebrew.
  The list is chezmoi/.chezmoidata/packages.yaml. Runs once per content hash;
  to re-run after editing the list: chezmoi state delete-bucket --bucket=scriptState
*/ -}}
{{- if .installPackages -}}
#!/bin/sh
set -eu

BREW=
if command -v brew >/dev/null 2>&1; then
  BREW=$(command -v brew)
else
  for candidate in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
    if [ -x "$candidate" ]; then
      BREW=$candidate
      break
    fi
  done
fi
if [ -z "$BREW" ]; then
  echo "Homebrew is not installed. Install it first (see README.md), then run: chezmoi apply" >&2
  exit 1
fi
eval "$("$BREW" shellenv)"

brewfile=$(mktemp)
trap 'rm -f "$brewfile"' EXIT
cat >"$brewfile" <<'EOF'
{{ range .packages.formulae -}}
brew {{ . | quote }}
{{ end -}}
{{- /* On WSL the terminal and font live on the Windows side. */ -}}
{{- if not .wsl -}}
{{-   range (index .packages.casks .chezmoi.os | default (list)) }}
cask {{ . | quote }}
{{-   end }}
{{ end -}}
EOF

"$BREW" bundle --file="$brewfile" --no-upgrade
{{- end }}
