# Lets Nix-installed Brave create user namespaces, which its sandbox needs on
# Ubuntu 24.04+. Same profile Brave's own .deb ships, pointed at /nix/store.
# https://ubuntu.com/blog/ubuntu-23-10-restricted-unprivileged-user-namespaces

abi <abi/4.0>,
include <tunables/global>

profile nix-brave /nix/store/*-brave-*/opt/brave.com/brave/brave flags=(unconfined) {
  userns,

  include if exists <local/nix-brave>
}
